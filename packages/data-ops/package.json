{
  "name": "@repo/data-ops",
  "version": "1.0.0",
  "description": "Manage auth, database, schemas, and queries",
  "exports": {
    "./auth/*": {
      "default": "./dist/auth/*.js",
      "types": "./dist/auth/*.d.ts"
    },
    "./database/*": {
      "default": "./dist/database/*.js",
      "types": "./dist/database/*.d.ts"
    },
    "./zod-schema/*": {
      "default": "./dist/zod-schema/*.js",
      "types": "./dist/zod-schema/*.d.ts"
    },
    "./queries/*": {
      "default": "./dist/queries/*.js",
      "types": "./dist/queries/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
    "better-auth:generate": "mkdir -p src/drizzle && npx @better-auth/cli@latest generate --config ./config/auth.ts --output ./src/drizzle/auth-schema.ts",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "drizzle:pull": "drizzle-kit pull --config drizzle.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "@neondatabase/serverless": "catalog:frontend",
    "@planetscale/database": "catalog:frontend",
    "@polar-sh/better-auth": "catalog:frontend",
    "@polar-sh/sdk": "catalog:frontend",
    "better-auth": "catalog:frontend",
    "better-sqlite3": "catalog:frontend",
    "drizzle-orm": "catalog:frontend",
    "zod": "catalog:frontend"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:dev",
    "@types/better-sqlite3": "catalog:build",
    "dotenv": "catalog:dev",
    "drizzle-kit": "catalog:dev",
    "mysql2": "catalog:frontend",
    "postgres": "catalog:frontend",
    "tsc-alias": "catalog:build",
    "typescript": "catalog:build"
  }
}
